# formapubli — biến môi trường mẫu (copy thành .env, KHÔNG commit .env thật)
# DB local dev (mặc định file:formapubli.db nếu bỏ trống)
DATABASE_URL=file:formapubli.db

# Mã PIN quản lý: lưu HASH, cách nhau bằng dấu phẩy — KHÔNG lưu PIN plain.
# Sinh hash V2: npx tsx -e "import('./src/lib/manager-pin').then(async m => console.log(await m.hashPinForEnv('9999')))"
# Salt phải giống nhau giữa lúc sinh hash và lúc chạy server.
# 2.4 BẮT BUỘC prod: thiếu MANAGER_PIN_HASHES ở NODE_ENV=production là server từ chối mọi PIN (fail-closed).
MANAGER_PIN_SALT=formapubli-pin-salt-2026
MANAGER_PIN_HASHES=

# Secret cho cron nội bộ gọi endpoint định kỳ (vd: dọn đơn PENDING, email mùng 1)
CRON_SECRET=doi-secret-ngau-nhien-o-day

# Resend gửi email báo cáo mùng 1 (free 3000/tháng) — Phase 3
RESEND_API_KEY=

# DB test cách ly (mặc định formapubli_test.db nếu bỏ trống)
TEST_DATABASE_FILE=formapubli_test.db

# --- Phase 5: Production Auth & Executive AI Copilot ---
# BẬT TRÊN PRODUCTION: Bắt buộc kiểm tra secret tối thiểu 32 ký tự, fail-closed khi thiếu key
# AUTH_STRICT=true # Chỉ bật production; dev local có thể để comment để dùng DEV key nếu chưa tạo secret

# Khóa bí mật ký phiên HMAC-SHA256: sinh bằng lệnh `openssl rand -hex 32` (bắt buộc ≥32 ký tự)
AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32

# --- GO-LIVE CLOUDFLARE (checklist, xem docs/GOLOIVE nếu có) ---
# 1. Turso: tạo DB, lấy URL + token. App KHÔNG dùng D1 binding (giữ wrangler.toml nguyên).
#    TURSO_DATABASE_URL=libsql://....turso.io
#    TURSO_AUTH_TOKEN=...
#    Migrate lần đầu: TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npx tsx scripts/migrate-remote.ts
# 2. Seed danh mục (KHÔNG seed staff prod): DATABASE_URL=<turso> DATABASE_AUTH_TOKEN=... npx tsx scripts/seed.ts
# 3. Bootstrap OWNER đầu tiên (DB phải trống staff):
#    DATABASE_URL=<turso> DATABASE_AUTH_TOKEN=... BOOTSTRAP_OWNER_PIN=<>=6 ký tự> npx tsx scripts/bootstrap-owner.ts
#    Xong UNSET BOOTSTRAP_OWNER_PIN ngay, đăng nhập đổi PIN riêng.
# 4. Cloudflare dashboard → Worker Settings → Variables:
#    AUTH_SECRET=<hex 32>, AUTH_STRICT=true, MANAGER_PIN_HASHES=<hash V2>,
#    MANAGER_PIN_SALT=<salt>, TRUST_PROXY=cloudflare, NODE_ENV=production,
#    DATABASE_URL=<turso>, DATABASE_AUTH_TOKEN=<token>
# 5. Deploy: push main (Pages/Workers Git integration build trên Linux).

# Ranh giới tin cậy proxy cho rate-limit/audit IP (#5/#6):
# - Sau Cloudflare: TRUST_PROXY=cloudflare (tin cf-connecting-ip)
# - Chạy trực tiếp 1 node (LAN team-test, VPS không proxy): TRUST_PROXY=direct
# - Production thiếu TRUST_PROXY: /api/auth/login fail-closed 500.
TRUST_PROXY=direct

# Model Gemini do Team B phê duyệt cho Phase 5 Copilot (chốt đo thật 17/09/2026: bản lite ~950ms, bản full chậm 8.4s/503)
GEMINI_MODEL=gemini-3.5-flash-lite

# Ngân sách gọi LLM tối đa / tháng (0 = không giới hạn, vượt ngưỡng chuyển sang fallback nội bộ)
LLM_MONTHLY_CALL_BUDGET=5000

# Groq Whisper STT cho 5.1 Voice POS (free: 2000 req/ngày, 8h audio/ngày).
# Giữ whisper-large-v3; chỉ đổi turbo sau khi measure-stt-wer chứng minh WER tương đương.
# Đo: GROQ_API_KEY=... npx tsx scripts/measure-stt-wer.ts --audio <file> --ref <txt>
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# Tầng chat Groq (opt-in, để trống = tắt; nhiều model cách nhau bằng dấu phẩy, thử theo thứ tự).
# Bench 8 case: gpt-oss-20b 24/24, qwen3.8-27b 21.5/24 (nhanh ~440ms).
# GROQ_CHAT_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b

